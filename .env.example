# Modèle des variables d'environnement. Copier en .env.local (jamais commité) et remplir.

# Neon (projet workhard) : chaîne de connexion « pooled » du rôle propriétaire, pour les migrations.
DATABASE_URL_OWNER=
# Neon : chaîne de connexion du rôle app_user (non propriétaire), utilisée par l'application.
DATABASE_URL=

# Better Auth : secret aléatoire (32 caractères ou plus) et URL de l'app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Origines supplémentaires autorisées par Better Auth (séparées par des virgules), ex. le port des tests e2e.
BETTER_AUTH_TRUSTED_ORIGINS=


# Connexion Google (facultative) : client OAuth créé dans ta console Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enseignant : adresses validées d'office, qui peuvent créer l'espace de la classe (séparées par des virgules ;
# « @ecole.fr » pour tout un domaine). Les étudiants créent leur compte et attendent la validation (page Membres).
ADMIN_EMAILS=

# Secret des tâches planifiées (Vercel l'envoie en en-tête Authorization).
CRON_SECRET=
