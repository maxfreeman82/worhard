# Modèle des variables d'environnement. Copier en .env.local (jamais commité) et remplir.

# Neon (projet workhard) : chaîne de connexion « pooled » du rôle propriétaire, pour les migrations.
DATABASE_URL_OWNER=
# Neon : chaîne de connexion du rôle app_user (non propriétaire), utilisée par l'application.
DATABASE_URL=

# Better Auth : secret aléatoire (32 caractères ou plus) et URL de l'app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
